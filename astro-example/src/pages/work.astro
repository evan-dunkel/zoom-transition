---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import ZoomRoot from "../components/ZoomRoot";
import "../zoom/zoom.css";

const projects = await getCollection("work");
const rendered = await Promise.all(projects.map(async (p) => ({ p, Content: (await render(p)).Content })));
---
<html lang="en">
  <body>
    <main class="grid">
      {projects.map((p) => (
        <a class="tile" href={`/work/${p.id}`}>
          <!-- Any content can be a source: an image, a video poster, a whole card. -->
          <div data-zoom-source={p.id} data-zoom-group="work" data-zoom-label={p.data.title}>
            <Image src={p.data.thumbnail} alt="" widths={[400, 800]} sizes="(max-width: 640px) 50vw, 33vw" />
          </div>
          <h2>{p.data.title}</h2>
        </a>
      ))}
    </main>

    <!-- One destination per project, rendered by Astro and kept inert until opened. -->
    {rendered.map(({ p, Content }) => (
      <template data-zoom-destination={p.id}>
        <article>
          <div data-zoom-hero>
            <Image src={p.data.cover} alt={p.data.title} widths={[800, 1600]} sizes="880px" />
          </div>
          <h1>{p.data.title}</h1>
          <p class="meta">{p.data.client}, {p.data.year}</p>
          <Content />
        </article>
      </template>
    ))}

    <ZoomRoot client:load />
  </body>
</html>
